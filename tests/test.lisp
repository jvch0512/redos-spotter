(load (merge-pathnames "../src/redos.lisp" (or *load-truename* *default-pathname-defaults*)))
(in-package :redos)

(defvar *passed* 0) (defvar *failed* 0)
(defmacro check (form name)
  `(if (handler-case ,form (error (e) (format t "  error in ~a: ~a~%" ,name e) nil))
       (incf *passed*)
       (progn (incf *failed*) (format t "FAIL: ~a~%" ,name))))

(defun rules (p) (sort (mapcar #'finding-rule (analyse-pattern p)) #'string<))
(defun clean-p (p) (null (analyse-pattern p)))
(defun steps (p s) (match-steps (parse-regex p) s))

;; parser and sets
(check (equal (parse-regex "a") (list :set (bit-mask 97))) "literal a")
(check (= (second (parse-regex ".")) +dot+) "dot excludes newline")
(check (= (second (parse-regex "\\d")) +digit+) "\\d")
(check (= (second (parse-regex "\\w")) +word+) "\\w")
(check (= (second (parse-regex "[0-9]")) +digit+) "range class")
(check (= (second (parse-regex "[^0-9]")) (logandc2 +all+ +digit+)) "negated class")
(check (= (second (parse-regex "[a-c\\d]")) (logior (range-mask 97 99) +digit+)) "class with escape")
(check (= (second (parse-regex "[a-]")) (mask-of-chars "a-")) "trailing hyphen in class")
(check (= (second (parse-regex "[]a]")) (mask-of-chars "]a")) "leading ] in class")
(check (eq (car (parse-regex "a|b")) :alt) "alternation")
(check (equal (subseq (parse-regex "a{2,5}") 0 4) (list :rep 2 5 (list :set (bit-mask 97)))) "braces range")
(check (equal (subseq (parse-regex "a{3}") 0 3) '(:rep 3 3)) "braces exact")
(check (null (third (parse-regex "a{2,}"))) "braces open")
(check (eq (car (parse-regex "a{x}")) :seq) "invalid braces are literal")
(check (eq (car (parse-regex "^a$")) :seq) "anchors parse")
(check (fifth (parse-regex "a++")) "possessive flagged")
(check (null (fifth (parse-regex "a+?"))) "lazy is not possessive")
(check (handler-case (progn (parse-regex "(a") nil) (bad-pattern () t)) "unbalanced open")
(check (handler-case (progn (parse-regex "a)") nil) (bad-pattern () t)) "unbalanced close")
(check (handler-case (progn (parse-regex "[a") nil) (bad-pattern () t)) "unterminated class")
(check (handler-case (progn (parse-regex "*a") nil) (bad-pattern () t)) "nothing to repeat")
(check (handler-case (progn (parse-regex "(a)\\1") nil) (unsupported () t)) "backreference unsupported")

;; language properties
(check (nullable-p (parse-regex "a*")) "a* nullable")
(check (not (nullable-p (parse-regex "a+"))) "a+ not nullable")
(check (nullable-p (parse-regex "a?b?")) "a?b? nullable")
(check (= (node-first (parse-regex "a?b")) (mask-of-chars "ab")) "first set skips nullable")
(check (= (node-last (parse-regex "ab?")) (mask-of-chars "ab")) "last set skips nullable")

;; vulnerable patterns
(check (equal (rules "(a+)+$") '("REDOS001")) "(a+)+")
(check (equal (rules "(a*)*") '("REDOS001")) "(a*)*")
(check (equal (rules "(.*)*") '("REDOS001")) "(.*)*")
(check (equal (rules "^(([a-z])+.)+[A-Z]([a-z])+$") '("REDOS001")) "classic email-ish")
(check (equal (rules "([a-zA-Z]+\\s?)*$") '("REDOS001")) "words with optional space")
(check (equal (rules "(x+x+)+y") '("REDOS001" "REDOS003")) "(x+x+)+ is nested and chained")
(check (equal (rules "(\\w|\\d)+@") '("REDOS002")) "alt overlap classes")
(check (equal (rules "(a|a)*b") '("REDOS002")) "alt identical")
(check (equal (rules ".*.*=.*") '("REDOS003")) "quadratic chain")
(check (eq (finding-severity (first (analyse-pattern ".*.*=.*"))) :medium) "quadratic is medium")
(check (eq (finding-severity (first (analyse-pattern "\\d+\\d+\\d+x"))) :high) "cubic is high")
(check (equal (rules "[a-z]+[a-z]*x") '("REDOS003")) "plus then star")

;; safe patterns stay clean
(check (clean-p "^[a-z0-9_.+-]+@[a-z0-9-]+\\.[a-z0-9.-]+$") "email")
(check (clean-p "^(ab+)+$") "(ab+)+ is safe")
(check (clean-p "^\\d{4}-\\d{2}-\\d{2}$") "date")
(check (clean-p "^(?:[a-z]+\\s)*[a-z]+$") "words separated by space")
(check (clean-p "a++b") "possessive")
(check (clean-p "(?>a+)+b") "atomic group")
(check (clean-p "(a|b)+") "disjoint alternation")
(check (clean-p "(foo|bar)*baz") "different words")
(check (clean-p "a+b+c+") "disjoint loops")
(check (clean-p "\\d+\\.\\d+") "separated loops")
(check (clean-p "^.*$") "single loop")
(check (clean-p "(a|ab)*c") "different length branches are not flagged")

;; unmodelled syntax is reported, not guessed
(check (equal (rules "(a)\\1+") '("REDOS000")) "backref info")
(check (equal (rules "(?=a)b") '("REDOS000")) "lookahead info")
(check (equal (rules "(a") '("REDOS000")) "bad pattern info")

;; evidence from the probe
(check (search "confirmed" (finding-message (first (analyse-pattern "(a+)+$")))) "evidence present")
(check (not (search "not confirmed" (finding-message (first (analyse-pattern "(a+)+$"))))) "exponential confirmed")
(check (> (steps "(a+)+$" "aaaaaaaaaaaaaaaaaaaa!") 100000) "exponential steps grow")
(check (< (steps "(a+)+$" "aaaaaaaaaaaaaaaaaaaa") 100) "matching input is fast")
(check (< (steps "^(ab+)+$" "abbbabbbabbbabbbabbbabbbabbb!") 200) "safe pattern is linear")
(check (multiple-value-bind (s m e) (steps "(a+)+$" (concatenate 'string (make-string 40 :initial-element #\a) "!")) (declare (ignore s m)) e) "budget stops runaway matching")

;; matcher semantics
(check (nth-value 1 (steps "a+b" "aaab")) "match a+b")
(check (not (nth-value 1 (steps "a+b" "aaa"))) "no match without b")
(check (nth-value 1 (steps "(ab|cd)*" "abcdab")) "alternation loop")
(check (nth-value 1 (steps "a{2,3}" "aaa")) "bounded repeat max")
(check (not (nth-value 1 (steps "a{2,3}" "aaaa"))) "bounded repeat over")
(check (nth-value 1 (steps "(a*)*b" "b")) "empty loop terminates")
(check (nth-value 1 (steps "[^a]+" "bcd")) "negated class match")
(check (not (nth-value 1 (steps "." (string #\Newline)))) "dot rejects newline")

;; CLI
(defun cli (&rest args)
  (let ((p (sb-ext:run-program "./bin/redos-spotter" args :output nil :error nil)))
    (sb-ext:process-exit-code p)))
(check (= (cli "examples/patterns.txt") 0) "cli ok")
(check (= (cli "examples/patterns.txt" "--fail-on" "high") 1) "cli fail-on high")
(check (= (cli "examples/patterns.txt" "--fail-on" "medium") 1) "cli fail-on medium")
(check (= (cli "/no/such/file") 2) "cli missing file")
(check (= (cli) 2) "cli usage")
(check (= (cli "examples/patterns.txt" "--bogus") 2) "cli bad flag")
(check (= (cli "examples/patterns.txt" "--fail-on" "nope") 2) "cli bad fail-on")

(format t "~d passed, ~d failed~%" *passed* *failed*)
(sb-ext:exit :code (if (zerop *failed*) 0 1) :abort t)
